# Resume Studio settings. To change one, copy this file to apps/web/.env.local (never committed) and edit it
# there, then restart `pnpm dev`. Every value here is the default: without a .env.local, the app behaves
# exactly like this.

# ---- Compiler: where TeX runs ---------------------------------------------------------------------------
# auto     this Mac's TeX if latexmk is installed (MacTeX), otherwise the Docker compile service
# local    always this Mac's TeX
# service  always the Docker compile service (start it with `docker compose up -d`)
RESUME_STUDIO_COMPILER=auto

# Where the compile service listens (only used when it's used).
RESUME_STUDIO_COMPILER_URL=http://127.0.0.1:4380

# The compile service's token, if you set TEX_SERVICE_TOKEN for it (empty: none).
RESUME_STUDIO_COMPILER_TOKEN=

# ---- Data --------------------------------------------------------------------------------------------------
# Where resumes/ and .resume-studio/ live. Default: the repository folder.
# RESUME_STUDIO_ROOT=/path/to/a/folder

# ---- API keys ----------------------------------------------------------------------------------------------
# Default: the macOS Keychain (on Linux and Windows, .resume-studio/secrets.json, readable only by you).
# "file" uses .resume-studio/secrets.json on macOS too (a headless Mac, where the Keychain prompts).
# RESUME_STUDIO_SECRET_STORE=file
