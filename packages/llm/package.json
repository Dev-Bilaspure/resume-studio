{
  "name": "@resume-studio/llm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./env": "./src/env.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./env": {
        "types": "./dist/env.d.ts",
        "default": "./dist/env.js"
      }
    }
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "smoke": "node --experimental-strip-types --no-warnings scripts/smoke.ts",
    "test": "node --experimental-strip-types --no-warnings --test 'src/**/*.test.ts'",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.81",
    "@ai-sdk/google-vertex": "^5.0.114",
    "@ai-sdk/openai": "^4.0.95",
    "ai": "^7.0.142",
    "ai-sdk-provider-claude-code": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3"
  }
}
