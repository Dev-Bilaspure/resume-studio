{
  "name": "@resume-studio/tailor-latex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./node": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.js"
      }
    }
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "node --experimental-strip-types --no-warnings --test 'src/**/*.test.ts'",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@resume-studio/tailor": "workspace:*",
    "@resume-studio/tex-service": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3"
  }
}
