{
  "name": "resume-studio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --filter=@resume-studio/web",
    "build": "turbo run build",
    "start": "pnpm --filter @resume-studio/web start",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "biome:lint": "biome check . && turbo run lint",
    "biome:fix": "biome check --write . && turbo run fix",
    "biome:format": "biome format --write .",
    "tailor": "node packages/tailor-cli/bin/resume-tailor.js",
    "eval": "node packages/tailor-eval/bin/tailor-eval.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "turbo": "^2.6.0"
  },
  "packageManager": "pnpm@10.28.2"
}
